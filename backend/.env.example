# ---------- App ----------
APP_NAME=YatraVerse
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://yatraverse:yatraverse@localhost:5432/yatraverse
SYNC_DATABASE_URL=postgresql+psycopg2://yatraverse:yatraverse@localhost:5432/yatraverse

# ---------- Auth ----------
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- AI (Phase 8) ----------
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---------- Weather (Phase 9) ----------
WEATHER_PROVIDER=mock
WEATHER_API_KEY=# ---------- App ----------
